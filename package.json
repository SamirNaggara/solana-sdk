{
  "name": "solana-dpp",
  "version": "2.0.0",
  "description": "Open-source TypeScript SDK for Digital Product Passports (DPP) on Solana: mint SPL tokens with hashed metadata, PostgreSQL storage, on-chain authenticity verification.",
  "main": "dist/client/solana-dpp-sdk.js",
  "types": "dist/client/solana-dpp-sdk.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "bin": {
    "solana-dpp-migrate": "dist/scripts/migrate.js"
  },
  "keywords": [
    "solana",
    "spl-token",
    "digital-product-passport",
    "dpp",
    "sdk",
    "typescript",
    "authenticity"
  ],
  "author": "Samir Naggara (https://github.com/SamirNaggara)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamirNaggara/solana-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/SamirNaggara/solana-sdk/issues"
  },
  "homepage": "https://github.com/SamirNaggara/solana-sdk",
  "scripts": {
    "start": "ts-node client/cli.ts",
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest tests/basic-hash-calculation.test.ts tests/hash-consistency.test.ts tests/hash-edge-cases.test.ts",
    "test:integration": "jest",
    "test:watch": "jest --watch",
    "test:mint": "jest --testNamePattern='Mint Management'",
    "test:mint:unit": "jest __tests__/SolanaDppSdk.mintManagement.test.ts",
    "test:mint:integration": "jest __tests__/SolanaDppSdk.mintManagement.integration.test.ts",
    "test:user-normalization": "jest __tests__/SolanaDppSdk.userNormalization.test.ts",
    "test:authenticity": "jest tests/authenticity-verification.test.ts",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:setup": "npm run db:migrate"
  },
  "dependencies": {
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@types/cli-progress": "^3.11.6",
    "bottleneck": "^2.19.5",
    "cli-progress": "^3.12.0",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "dotenv": "^17.2.1",
    "jest": "^30.0.3",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3"
  },
  "contributors": [
    "Samir Naggara <samirm.nagg@gmail.com> (https://github.com/SamirNaggara)",
    "Axel Giguaire (https://github.com/MrFeuylle)"
  ]
}
