{
  "name": "safeout-solana",
  "version": "1.0.4",
  "description": "Solana Token Minting Project",
  "main": "dist/client/class_safeout.js",
  "types": "dist/client/class_safeout.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "ts-node mintToken.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:mint": "jest --testNamePattern='Mint Management'",
    "test:mint:unit": "jest __tests__/SafeoutSDK.mintManagement.test.ts",
    "test:mint:integration": "jest __tests__/SafeoutSDK.mintManagement.integration.test.ts",
    "test:user-normalization": "jest __tests__/SafeoutSDK.userNormalization.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "db:setup": "npm run prisma:push && npm run prisma:generate",
    "db:setup:migrate": "npm run prisma:deploy && npm run prisma:generate"
  },
  "dependencies": {
    "@solana/spl-memo": "^0.2.5",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@types/cli-progress": "^3.11.6",
    "bottleneck": "^2.19.5",
    "cli-progress": "^3.12.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@prisma/client": "^6.10.1",
    "@types/jest": "^30.0.0",
    "@types/node-fetch": "^2.6.12",
    "dotenv": "^17.2.1",
    "jest": "^30.0.3",
    "prisma": "^6.10.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.4.0",
    "typescript": "^5.8.3"
  }
}
